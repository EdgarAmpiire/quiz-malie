---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const team = [
  { name: 'Damalie Patra Achan', title: 'Chief Executive Officer', img: '/team/damalie.jpeg' },
  { name: 'Aaron Tumukunde', title: 'Operations Manager', img: '/team/aaron.jpeg' },
  { name: 'Kenneth Baguma ', title: 'Creative Director/Human Resources Manager', img: '' },
  { name: 'Jonathan Areeba', title: 'Adjudicator & Trainer Crossfire', img: '' },
  { name: 'Joel N Mungai', title: 'Lead Graphics/Branding Division', img: '' },
  { name: 'Ramathan K', title: 'Specialist, Motion & Sound Effects', img: '' },
  { name: 'Joshua Olega', title: 'Adjudicator/Ass. Project Coordinator & Trainer Crossfire', img: '/team/olega.jpeg' },
  { name: 'Linda Kakayi', title: 'Project Coordinator/Adjuducator Crossfire', img: '' },
  { name: 'Mubiru John Bosco', title: 'Adjudicator & Trainer Crossfire', img: '/team/mubiru.jpeg' },
  { name: 'Dr. Francis Kanyike', title: 'Producer, Obulamu Bwo Show', img: '' },
  { name: 'Nakabira Abigeal', title: 'Adjudicator & Trainer Crossfire', img: '' },
  { name: 'Ruben Omara', title: 'Adjudicator & Trainer Crossfire', img: '' },
  { name: 'Solomon Mbiira Mwesigwa', title: 'Adjudicator & Trainer Crossfire', img: '/team/solo.jpeg' },
];
---
<Layout title="About Us — Quiz Malie Uganda Limited">
  <Navbar />

  <header class="about-hero">
    <div class="about-hero-bg" style="background-image: linear-gradient(rgba(6,10,16,0.62), rgba(6,10,16,0.82)), url('/about-us/hero.jpg')"></div>
    <div class="about-hero-inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">›</span>
        <span class="crumb-current">About Us</span>
      </nav>
      <span class="about-cat">Who We Are</span>
      <h1>About Quiz Malie Uganda Limited</h1>
    </div>
  </header>

  <div class="about-page-body">
    <div class="about-story reveal">
      <p>Quiz Malie Uganda Limited is a fully registered media company based in Uganda with over 15 years of experience in the media and communications industry. Since its establishment, the company has been dedicated to creating impactful, educational, and entertaining content that serves audiences across Uganda, East Africa, and the African continent.</p>
      <p>Through its production arm, Quiz Malie Studios, the company has become one of Uganda's leading content creation and production houses. It is widely recognised for producing high-quality educational television programmes that inspire learning, promote knowledge, and empower communities.</p>
      <p>Over the years, Quiz Malie Uganda Limited has built strong partnerships with some of Uganda's most respected media organisations, including NTV Uganda, UBC TV, and the New Vision Group. These collaborations have enabled the company to reach millions of viewers and deliver content that makes a positive impact on society.</p>
      <p>Driven by innovation, creativity, and a commitment to excellence, Quiz Malie Uganda Limited continues to develop engaging media solutions, television productions, educational programmes, digital content, and communication campaigns that meet the evolving needs of audiences and partners across Africa.</p>
    </div>

    <div class="amv reveal">
      <div class="amv-card mission">
        <h3>Our Mission</h3>
        <p>To educate, inform, and inspire communities through innovative media productions and high-quality content that promotes learning, development, and social transformation.</p>
      </div>
      <div class="amv-card vision">
        <h3>Our Vision</h3>
        <p>To be Africa's leading educational media and content production company, creating content that empowers people and drives positive change across the continent.</p>
      </div>
    </div>

    <div class="about-tagline reveal">
      <p>Educating, Inspiring, and <span>Transforming Lives</span> Through Media</p>
    </div>
  </div>

  <section class="team-section">
    <div class="reveal team-head">
      <div class="section-label">Our People</div>
      <h2 class="section-title">Meet the <span>Team</span></h2>
    </div>
    <div class="team-grid">
      {team.map((member) => (
        <div class="team-card reveal">
          <div class="team-photo">
            <img
              src={member.img || '/team/avatar.svg'}
              alt={member.name}
              loading="lazy"
              onerror="this.onerror=null; this.src='/team/avatar.svg';"
            />
        </div>
          <h3 class="team-name">{member.name}</h3>
          <p class="team-role">{member.title}</p>
        </div>
      ))}
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Hero */
  .about-hero {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: flex-end;
    padding: 130px 8% 60px;
    overflow: hidden;
  }
  .about-hero-bg { position: absolute; inset: 0; background-size: cover; background-position: center; }
  .about-hero-inner { position: relative; z-index: 2; max-width: 900px; }
  .crumbs {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    margin-bottom: 1.3rem;
    padding: 8px 16px;
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 100px;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(4px);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.7rem;
  }
  .crumbs a { color: rgba(255,255,255,0.8); text-decoration: none; transition: color 0.25s; }
  .crumbs a:hover { color: #fff; }
  .crumb-sep { color: rgba(255,255,255,0.45); }
  .crumb-current { color: #fff; }
  .about-cat {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-green-neon);
    margin-bottom: 0.8rem;
  }
  .about-hero h1 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2rem, 4.5vw, 3.6rem);
    line-height: 1;
    text-transform: uppercase;
    color: #fff;
    letter-spacing: -0.01em;
  }

  /* Body */
  .about-page-body { width: 80%; max-width: 1360px; margin: 0 auto; padding: 80px 0; }
  .about-story p {
    font-size: 1.02rem;
    color: rgba(255,255,255,0.62);
    line-height: 1.85;
    font-weight: 300;
    margin-bottom: 1.3rem;
  }

  .amv {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 56px 0;
  }
  .amv-card {
    border-radius: 16px;
    padding: 32px;
    border: 1px solid rgba(255,255,255,0.08);
    background: var(--color-dark-elevated);
  }
  .amv-card.mission { border-top: 3px solid var(--color-green-neon); }
  .amv-card.vision { border-top: 3px solid var(--color-orange); }
  .amv-card h3 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.4rem;
    text-transform: uppercase;
    color: #F0F2F8;
    margin-bottom: 0.6rem;
    letter-spacing: 0.02em;
  }
  .amv-card p { font-size: 0.98rem; color: rgba(255,255,255,0.55); line-height: 1.8; font-weight: 300; }

  .about-tagline { text-align: center; margin-top: 24px; }
  .about-tagline p {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    text-transform: uppercase;
    color: rgba(255,255,255,0.82);
    letter-spacing: 0.01em;
    line-height: 1.25;
  }
  .about-tagline p span { color: var(--color-green-neon); }

  /* Team */
  .team-section { padding: 80px 8% 120px; background: var(--color-dark-elevated); }
  .team-head { text-align: center; margin-bottom: 56px; }
  .team-head .section-label { justify-content: center; }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 28px 22px;
  }
  .team-card { text-align: center; }
  .team-photo {
    aspect-ratio: 3/4;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 14px;
    background: var(--color-dark-surface);
    border: 1px solid rgba(255,255,255,0.06);
  }
  .team-photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s; }
  .team-card:hover .team-photo img { transform: scale(1.05); }
  .team-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: #F0F2F8;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: 2px;
    line-height: 1.1;
  }
  .team-role { font-size: 0.82rem; color: rgba(255,255,255,0.45); }

  @media (max-width: 1100px) {
    .team-grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 768px) {
    .amv { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .team-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
