---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { services } from '../../data/services';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

// Build the gallery from the service's public folder:
//  • An image with no matching PDF  -> a normal photo.
//  • A PDF + an image with the SAME base name (e.g. report.pdf + report.jpg)
//    -> a PDF tile that uses that image as its thumbnail and opens the PDF.
//  • A PDF with no matching image   -> a document tile (file icon + name).
const dir = path.join(process.cwd(), 'public', 'services', service.slug);
const urlBase = `/services/${service.slug}`;
const imgRe = /\.(jpe?g|png|webp|avif|gif)$/i;
const stripExt = (f: string) => f.replace(/\.[^.]+$/, '');
const numeric = (a: string, b: string) => a.localeCompare(b, undefined, { numeric: true });

let gallery: { src?: string; alt: string; pdf?: string }[] = [];
try {
  const files = fs.readdirSync(dir);
  const pdfs = files.filter((f) => /\.pdf$/i.test(f));
  const images = files.filter((f) => imgRe.test(f));
  const pdfBases = new Set(pdfs.map(stripExt));

  const thumbFor: Record<string, string> = {};
  for (const img of images) {
    const b = stripExt(img);
    if (pdfBases.has(b)) thumbFor[b] = img;
  }

  const photos = images
    .filter((img) => !pdfBases.has(stripExt(img)))
    .sort(numeric)
    .map((img) => ({ src: `${urlBase}/${img}`, alt: `${service.name} — photo` }));

  const docs = pdfs.sort(numeric).map((pdf) => {
    const b = stripExt(pdf);
    return {
      src: thumbFor[b] ? `${urlBase}/${thumbFor[b]}` : undefined,
      alt: b.replace(/[-_]/g, ' '),
      pdf: `${urlBase}/${pdf}`,
    };
  });

  gallery = [...photos, ...docs];
} catch {
  gallery = [];
}
---
<Layout title={`${service.name} — Quiz Malie Uganda Limited`}>
  <Navbar />
  <main class="service-page">
    <header class="service-hero">
      <a href="/#services" class="hero-back">← All Services</a>
      <div class="service-hero-inner">
        <div class="service-hero-icon">
          <svg width="34" height="34" fill="none" stroke="#fff" stroke-width="2" viewBox="0 0 24 24" set:html={service.icon}></svg>
        </div>
        <h1>{service.name}</h1>
        <p>{service.blurb}</p>
      </div>
    </header>

    {gallery.length > 0 && (
      <section class="service-gallery-section reveal">
        <div class="section-label">Gallery</div>
        <h2 class="section-title">Our <span>Work</span></h2>
        <div class="service-gallery">
          {gallery.map((img) => (
            img.pdf && !img.src ? (
              <a class="sg-item sg-card" href={img.pdf} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
                <span class="sg-card-label">{img.alt}</span>
                <span class="sg-badge">PDF</span>
              </a>
            ) : img.pdf ? (
              <a class="sg-item sg-doc" href={img.pdf} target="_blank" rel="noopener">
                <img src={img.src} alt={img.alt} loading="lazy" />
                <span class="sg-badge">PDF</span>
              </a>
            ) : (
              <div class="sg-item sg-photo"><img src={img.src} alt={img.alt} loading="lazy" /></div>
            )
          ))}
        </div>
      </section>
    )}

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lb-close" id="lbClose" aria-label="Close">&times;</button>
      <button class="lb-nav lb-prev" id="lbPrev" aria-label="Previous">&#8249;</button>
      <img class="lb-img" id="lbImg" src="" alt="" />
      <button class="lb-nav lb-next" id="lbNext" aria-label="Next">&#8250;</button>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .service-hero {
    position: relative;
    background: linear-gradient(135deg, #0A180E 0%, var(--color-dark-base) 100%);
    padding: 160px 8% 90px;
    text-align: center;
    color: #fff;
    border-bottom: 1px solid rgba(0,232,122,0.12);
  }
  .hero-back {
    position: absolute;
    top: 104px;
    left: 8%;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: rgba(255,255,255,0.9);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    padding: 8px 16px;
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 100px;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(4px);
    transition: background 0.25s, border-color 0.25s, transform 0.2s;
  }
  .hero-back:hover { background: rgba(255,255,255,0.2); border-color: #fff; transform: translateX(-3px); }
  @media (max-width: 560px) { .hero-back { top: 92px; } }

  .service-hero-inner { max-width: 760px; margin: 0 auto; }
  .service-hero-icon {
    width: 76px; height: 76px;
    margin: 0 auto 24px;
    background: rgba(255,255,255,0.16);
    border-radius: 18px;
    display: flex; align-items: center; justify-content: center;
  }
  .service-hero h1 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    text-transform: uppercase;
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin-bottom: 1.1rem;
  }
  .service-hero p { font-size: 1.1rem; line-height: 1.7; font-weight: 300; color: rgba(255,255,255,0.92); }

  .service-gallery-section { width: 80%; max-width: 1360px; margin: 0 auto; padding: 80px 0 110px; }
  .service-gallery-section .section-title { margin-bottom: 48px; }
  .service-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .sg-item {
    aspect-ratio: 4/3;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }
  .sg-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .sg-item:hover img { transform: scale(1.06); }
  .sg-photo img { cursor: pointer; }

  /* PDF tiles */
  .sg-doc, .sg-card { position: relative; display: block; }
  .sg-badge {
    position: absolute; top: 10px; right: 10px;
    background: #d32f2f; color: #fff;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em;
    padding: 4px 9px; border-radius: 6px;
  }
  .sg-card {
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 12px;
    background: var(--color-dark-elevated);
    color: #E8EAF0; text-decoration: none; text-align: center;
    padding: 24px;
  }
  .sg-card svg { width: 46px; height: 46px; stroke: var(--color-green-neon); }
  .sg-card-label { font-weight: 600; font-size: 0.9rem; line-height: 1.3; text-transform: capitalize; }

  @media (max-width: 900px) {
    .service-gallery { grid-template-columns: repeat(2, 1fr); }
    .service-gallery-section { width: 88%; }
  }
  @media (max-width: 560px) { .service-gallery { grid-template-columns: 1fr; } }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(8,16,28,0.92);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vh 4vw;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s;
  }
  .lightbox.open { opacity: 1; visibility: visible; }
  .lb-img {
    max-width: 92vw;
    max-height: 88vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.5);
    transform: scale(0.96);
    transition: transform 0.3s ease;
  }
  .lightbox.open .lb-img { transform: scale(1); }
  .lb-close, .lb-nav {
    position: absolute;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.25);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }
  .lb-close:hover, .lb-nav:hover { background: rgba(255,255,255,0.28); }
  .lb-close { top: 20px; right: 24px; width: 46px; height: 46px; border-radius: 50%; font-size: 1.8rem; line-height: 1; }
  .lb-nav { top: 50%; transform: translateY(-50%); width: 52px; height: 52px; border-radius: 50%; font-size: 2rem; }
  .lb-prev { left: 20px; }
  .lb-next { right: 20px; }
  @media (max-width: 600px) {
    .lb-nav { width: 42px; height: 42px; font-size: 1.6rem; }
    .lb-prev { left: 8px; } .lb-next { right: 8px; }
    .lb-close { top: 12px; right: 12px; }
  }
</style>

<script>
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lbImg') as HTMLImageElement;
  const imgs = Array.from(document.querySelectorAll('.sg-photo img'));
  let idx = 0;

  function show(i: number) {
    idx = (i + imgs.length) % imgs.length;
    lbImg.src = imgs[idx].getAttribute('src') || '';
    lbImg.alt = imgs[idx].getAttribute('alt') || '';
  }
  function open(i: number) {
    show(i);
    lb?.classList.add('open');
    lb?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function close() {
    lb?.classList.remove('open');
    lb?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  imgs.forEach((img, i) => img.addEventListener('click', () => open(i)));
  document.getElementById('lbClose')?.addEventListener('click', close);
  document.getElementById('lbPrev')?.addEventListener('click', (e) => { e.stopPropagation(); show(idx - 1); });
  document.getElementById('lbNext')?.addEventListener('click', (e) => { e.stopPropagation(); show(idx + 1); });
  lb?.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => {
    if (!lb?.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
</script>