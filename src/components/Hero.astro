---
<section id="home">
  <div class="hero-carousel">
    <div class="hero-slide active" style="background-image: url('/hero/hero-2.jpg');">
      <div class="hero-grid"></div>
      <div class="hero-content">
        <div class="slide-tag"><span></span> Uganda's Premier Quiz Platform</div>
        <h1 class="hero-headline">Where<br /><em>Knowledge</em><br /><span class="fill-word">Meets Stage</span></h1>
        <p class="hero-sub">Bringing Uganda's brightest young minds together through education, entertainment, and the thrill of competition.</p>
        <div class="hero-btns">
          <a href="#gallery" class="btn-primary">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            View Events
          </a>
          <a href="#about" class="btn-outline">Learn More</a>
        </div>
      </div>
    </div>

    <div class="hero-slide" style="background-image: url('/hero/hero-3.jpg');">
      <div class="hero-grid"></div>
      <div class="hero-content">
        <div class="slide-tag"><span></span> Face to Face School Quiz</div>
        <h1 class="hero-headline">Inspiring<br /><em>Critical</em><br /><span class="fill-word">Thinking</span></h1>
        <p class="hero-sub">Over 150 schools, 3 national grand finales, and 78+ episodes of educational content broadcast across Uganda.</p>
        <div class="hero-btns">
          <a href="#services" class="btn-primary">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 8 16 12 12 16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            Our Services
          </a>
          <a href="#contact" class="btn-outline">Get In Touch</a>
        </div>
      </div>
    </div>

    <div class="hero-slide" style="background-image: url('/hero/hero-1.jpg');">
      <div class="hero-grid"></div>
      <div class="hero-content">
        <div class="slide-tag"><span></span> Health & Education Content</div>
        <h1 class="hero-headline">Educate.<br /><em>Entertain.</em><br /><span class="fill-word">Empower.</span></h1>
        <p class="hero-sub">Uganda's #1 online platform for educative, informative, and entertaining health and school content.</p>
        <div class="hero-btns">
          <a href="#contact" class="btn-primary">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.23 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.14v2.78z"/></svg>
            Partner With Us
          </a>
          <a href="#about" class="btn-outline">Our Story</a>
        </div>
      </div>
    </div>
  </div>

  <div class="carousel-indicators">
    <div class="dot active"></div>
    <div class="dot"></div>
    <div class="dot"></div>
  </div>
  <div class="carousel-arrows">
    <button class="arrow-btn arrow-prev" aria-label="Previous slide">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="arrow-btn arrow-next" aria-label="Next slide">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>
</section>

<style>
  #home {
    position: relative;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
  }
  .hero-carousel { position: absolute; inset: 0; }
  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1.2s ease;
    background-size: cover;
    background-position: center;
  }
  .hero-slide.active { opacity: 1; pointer-events: auto; }
  .hero-slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(6,10,16,0.85) 0%, rgba(6,10,16,0.6) 35%, rgba(6,10,16,0.2) 65%, rgba(6,10,16,0) 88%),
      linear-gradient(0deg, rgba(6,10,16,0.45) 0%, rgba(6,10,16,0) 35%);
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 96px 8% 60px;
    max-width: 900px;
  }
  .slide-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(40,184,112,0.18);
    border: 1px solid rgba(40,184,112,0.4);
    color: #6ae8b0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 100px;
    margin-bottom: 1.5rem;
    width: fit-content;
    opacity: 0;
    transform: translateY(20px);
    animation: slideUp 0.8s 0.3s forwards;
  }
  .slide-tag span { width: 6px; height: 6px; background: var(--color-green-light); border-radius: 50%; display: inline-block; }
  .hero-headline {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.92;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
    opacity: 0;
    transform: translateY(30px);
    animation: slideUp 0.9s 0.5s forwards;
  }
  .hero-headline em { font-style: normal; color: var(--color-green-light); }
  .hero-headline .fill-word {
    color: #fff;
  }
  .hero-sub {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.72);
    max-width: 500px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    font-weight: 300;
    opacity: 0;
    transform: translateY(20px);
    animation: slideUp 0.9s 0.7s forwards;
  }
  .hero-btns {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(20px);
    animation: slideUp 0.9s 0.9s forwards;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--color-green-light);
    color: #fff;
    padding: 14px 32px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: background 0.25s, transform 0.2s, box-shadow 0.25s;
    border: none; cursor: pointer;
  }
  .btn-primary:hover { background: var(--color-orange); transform: translateY(-3px); box-shadow: 0 12px 30px rgba(239,107,50,0.35); }
  .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    color: #fff;
    padding: 14px 32px;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1.5px solid rgba(255,255,255,0.4);
    transition: border-color 0.25s, background 0.25s, transform 0.2s;
    cursor: pointer;
  }
  .btn-outline:hover { border-color: #fff; background: rgba(255,255,255,0.08); transform: translateY(-3px); }
  .carousel-indicators {
    position: absolute;
    bottom: 40px;
    left: 8%;
    z-index: 10;
    display: flex;
    gap: 10px;
  }
  .dot {
    width: 28px; height: 3px;
    background: rgba(255,255,255,0.3);
    border-radius: 2px;
    cursor: pointer;
    transition: background 0.3s, width 0.3s;
  }
  .dot.active { background: var(--color-green-light); width: 48px; }
  .carousel-arrows {
    position: absolute;
    bottom: 32px;
    right: 8%;
    z-index: 10;
    display: flex;
    gap: 10px;
  }
  .arrow-btn {
    width: 44px; height: 44px;
    border: 1.5px solid rgba(255,255,255,0.35);
    background: transparent;
    color: #fff;
    border-radius: 8px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.25s, border-color 0.25s, transform 0.2s;
  }
  .arrow-btn:hover { background: rgba(255,255,255,0.12); border-color: #fff; transform: scale(1.05); }

  @keyframes slideUp { to { opacity: 1; transform: translateY(0); } }

  /* Short viewports (laptops) — keep the hero clear of the fixed navbar */
  @media (max-height: 800px) {
    .hero-content { padding-top: 92px; padding-bottom: 44px; }
    .slide-tag { margin-bottom: 1rem; }
    .hero-headline { font-size: clamp(4.8rem, 7.4vh, 5.2rem); margin-bottom: 1.1rem; }
    .hero-sub { margin-bottom: 1.6rem; }
  }
  @media (max-height: 660px) {
    #home { min-height: 560px; }
    .hero-content { padding-top: 88px; padding-bottom: 36px; }
    .hero-headline { font-size: clamp(2.3rem, 6.4vh, 4rem); }
    .hero-sub { font-size: 0.95rem; margin-bottom: 1.3rem; }
  }
</style>

<script>
  const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
  const dots = document.querySelectorAll<HTMLElement>('.dot');
  let current = 0;
  let autoplay: ReturnType<typeof setInterval>;

  function goToSlide(n: number) {
    slides[current].classList.remove('active');
    dots[current].classList.remove('active');
    current = (n + slides.length) % slides.length;
    slides[current].classList.add('active');
    dots[current].classList.add('active');
    const content = slides[current].querySelector('.hero-content');
    content?.querySelectorAll<HTMLElement>('.slide-tag, .hero-headline, .hero-sub, .hero-btns').forEach((el) => {
      el.style.animation = 'none';
      void el.offsetHeight;
      el.style.animation = '';
    });
  }
  function start() { autoplay = setInterval(() => goToSlide(current + 1), 5000); }
  function next() { clearInterval(autoplay); goToSlide(current + 1); start(); }
  function prev() { clearInterval(autoplay); goToSlide(current - 1); start(); }

  dots.forEach((dot, i) => dot.addEventListener('click', () => { clearInterval(autoplay); goToSlide(i); start(); }));
  document.querySelector('.arrow-prev')?.addEventListener('click', prev);
  document.querySelector('.arrow-next')?.addEventListener('click', next);
  start();
</script>
