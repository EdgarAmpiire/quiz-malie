---
---
<section id="about">
  <!-- Intro -->
  <div class="about-intro reveal">
    <div class="section-label">Who We Are</div>
    <h2 class="about-headline">Uganda's Leading <span>Educational Media</span> Company</h2>
    <p class="about-text about-lead">Quiz Malie Uganda Limited is a fully registered media company based in Uganda with over 15 years of experience in the media and communications industry. Since our founding, we've been dedicated to creating impactful, educational, and entertaining content for audiences across Uganda, East Africa, and the wider African continent.</p>

    <div class="stats-row">
      <div class="stat-item">
        <span class="stat-num">15<span>+</span></span>
        <span class="stat-lbl">Years Experience</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">1M<span>+</span></span>
        <span class="stat-lbl">Viewers Reached</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">3</span>
        <span class="stat-lbl">Major Media Partners</span>
      </div>
    </div>
  </div>

  <!-- Feature cards -->
  <div class="about-features">
    <div class="about-feature reveal stagger-1">
      <div class="feature-icon">
        <svg width="24" height="24" fill="none" stroke="var(--color-green)" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      </div>
      <div class="feature-name">Quiz Malie Studios</div>
      <p class="feature-text">Through our production arm, Quiz Malie Studios, we've become one of Uganda's leading content creation and production houses — widely recognised for high-quality educational television that inspires learning, promotes knowledge, and empowers communities.</p>
    </div>

    <div class="about-feature reveal stagger-2">
      <div class="feature-icon">
        <svg width="24" height="24" fill="none" stroke="var(--color-green)" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
      </div>
      <div class="feature-name">Trusted Partnerships</div>
      <p class="feature-text">We've built strong partnerships with some of Uganda's most respected media organisations, including NTV Uganda, UBC TV, and the New Vision Group — collaborations that let us reach millions of viewers and deliver content that makes a positive impact on society.</p>
    </div>

    <div class="about-feature reveal stagger-3">
      <div class="feature-icon">
        <svg width="24" height="24" fill="none" stroke="var(--color-green)" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      </div>
      <div class="feature-name">Driven by Innovation</div>
      <p class="feature-text">Guided by innovation, creativity, and a commitment to excellence, we develop television productions, educational programmes, digital content, and communication campaigns that meet the evolving needs of audiences and partners across Africa.</p>
    </div>
  </div>

  <!-- Mission & Vision -->
  <div class="about-mv">
    <div class="mv-card mission reveal-left">
      <div class="mv-head">
        <div class="mv-icon">
          <svg width="22" height="22" fill="none" stroke="var(--color-green)" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
        </div>
        <span class="mv-label">Our Mission</span>
      </div>
      <p class="mv-text">To educate, inform, and inspire communities through innovative media productions and high-quality content that promotes learning, development, and social transformation.</p>
    </div>

    <div class="mv-card vision reveal-right">
      <div class="mv-head">
        <div class="mv-icon">
          <svg width="22" height="22" fill="none" stroke="var(--color-blue)" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </div>
        <span class="mv-label">Our Vision</span>
      </div>
      <p class="mv-text">To be Africa's leading educational media and content production company, creating content that empowers people and drives positive change across the continent.</p>
    </div>
  </div>

  <!-- Tagline -->
  <div class="about-tagline reveal">
    <p>Educating, Inspiring, and <span>Transforming Lives</span> Through Media</p>
  </div>
</section>

<style>
  #about { padding: 120px 8% 100px; background: #fff; }

  /* Intro */
  .about-intro { max-width: 820px; margin: 0 auto; text-align: center; }
  .about-headline {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.5rem, 4vw, 4rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-navy);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }
  .about-headline span { color: var(--color-green); }
  .about-text {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    font-weight: 300;
  }
  .about-lead { max-width: 720px; margin: 0 auto; }
  .stats-row {
    display: flex;
    justify-content: center;
    gap: 56px;
    max-width: 720px;
    margin: 2.5rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid var(--color-light-gray);
  }
  .stat-item { text-align: center; }
  .stat-num {
    font-family: var(--font-heading);
    font-size: 2.6rem;
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1;
    display: block;
  }
  .stat-num span { color: var(--color-green); }
  .stat-lbl {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    font-weight: 400;
    letter-spacing: 0.04em;
    margin-top: 4px;
    display: block;
  }

  /* Feature cards */
  .about-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 90px;
  }
  .about-feature {
    background: #fff;
    border: 1px solid var(--color-light-gray);
    border-radius: 16px;
    padding: 32px 28px;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
  }
  .about-feature::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-green-light), var(--color-blue-mid));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }
  .about-feature:hover { transform: translateY(-8px); box-shadow: 0 20px 50px rgba(13,59,122,0.12); border-color: transparent; }
  .about-feature:hover::before { transform: scaleX(1); }
  .feature-icon {
    width: 52px; height: 52px;
    background: var(--color-green-pale);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }
  .feature-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--color-navy);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 0.6rem;
  }
  .feature-text {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    font-weight: 300;
  }

  /* Mission & Vision */
  .about-mv {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 24px;
  }
  .mv-card {
    border-radius: 16px;
    padding: 36px 34px;
    border: 1px solid var(--color-light-gray);
    background: var(--color-off-white);
  }
  .mv-card.mission { border-top: 3px solid var(--color-green-light); }
  .mv-card.vision { border-top: 3px solid var(--color-blue-mid); }
  .mv-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 1rem;
  }
  .mv-icon {
    width: 46px; height: 46px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .mv-card.mission .mv-icon { background: var(--color-green-pale); }
  .mv-card.vision .mv-icon { background: #e6effb; }
  .mv-label {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.6rem;
    text-transform: uppercase;
    color: var(--color-navy);
    letter-spacing: 0.02em;
  }
  .mv-text {
    font-size: 0.98rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    font-weight: 300;
  }

  /* Tagline */
  .about-tagline {
    margin-top: 60px;
    text-align: center;
    padding: 0 6%;
  }
  .about-tagline p {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    text-transform: uppercase;
    color: var(--color-navy);
    letter-spacing: 0.01em;
    line-height: 1.25;
  }
  .about-tagline p span { color: var(--color-green); }

  @media (max-width: 900px) {
    .about-features { grid-template-columns: 1fr; }
    .about-mv { grid-template-columns: 1fr; }
    .stats-row { gap: 32px; }
  }
</style>