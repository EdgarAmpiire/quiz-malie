---
import { programs } from '../data/programs';

const cards = programs.map((p, i) => {
  const accent  = p.brand?.primaryOnDark ?? '#28B870';
  const primary = p.brand?.primary      ?? '#1A8A5A';
  return {
    ...p,
    href: `/programs/${p.slug}`,
    featured: i === 0,
    cardStyle: `--ca:${accent}; --cp:${primary};`,
  };
});
---
<section id="gallery">
  <div class="reveal">
    <div class="section-label">Programs & Gallery</div>
    <h2 class="section-title">Moments That<br /><span>Define</span> Us</h2>
  </div>
  <div class="events-grid">
    {cards.map((p) => (
      <a href={p.href} class:list={["event-card", "reveal", p.featured && "featured"]} style={p.cardStyle}>
        <div class="event-img"><img src={p.heroImage} alt={p.title} /></div>
        <div class="event-scrim"></div>
        <div class="event-glass">
          <div class="glass-shimmer"></div>
          <span class="event-cat">{p.category}</span>
          <h3 class="event-title">{p.title}</h3>
          <div class="glass-footer">
            <p class="event-meta">{p.cardMeta}</p>
            <span class="event-cta">
              Explore
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  #gallery { padding: 120px 8% 100px; background: linear-gradient(180deg, var(--color-off-white) 0%, #fff 40%); }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 50px;
  }

  /* ── card shell ── */
  .event-card {
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    background: #06080e;
    text-decoration: none;
    display: block;
    border: 1px solid rgba(255,255,255,0.08);
    transition:
      transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94),
      box-shadow 0.5s,
      border-color 0.5s;
  }
  .event-card:hover {
    transform: translateY(-7px);
    border-color: color-mix(in srgb, var(--ca) 55%, transparent);
    box-shadow:
      0 28px 56px rgba(6,10,16,0.22),
      0 0 28px color-mix(in srgb, var(--ca) 12%, transparent);
  }

  /* ── photo ── */
  .event-img { width: 100%; aspect-ratio: 16/9; overflow: hidden; }
  .event-img img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 0.75s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .event-card:hover .event-img img { transform: scale(1.08); }

  /* ── atmospheric scrim — very light, fades on hover as glass takes over ── */
  .event-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(
      to top,
      rgba(6,10,16,0.55) 0%,
      rgba(6,10,16,0.08) 50%,
      transparent 72%
    );
    pointer-events: none;
    transition: opacity 0.5s;
  }
  .event-card:hover .event-scrim { opacity: 0.3; }

  /* ── glass panel — slides up from below ── */
  .event-glass {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 20px 22px 22px;
    background: color-mix(in srgb, var(--cp) 6%, rgba(6,10,16,0.22));
    backdrop-filter: blur(44px) saturate(260%);
    -webkit-backdrop-filter: blur(44px) saturate(260%);
    border-top: 1px solid color-mix(in srgb, var(--ca) 35%, rgba(255,255,255,0.12));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.1);
    overflow: hidden;

    transform: translateY(100%);
    opacity: 0;
    transition:
      transform 0.55s cubic-bezier(0.22,1,0.36,1),
      opacity 0.4s ease;
  }
  .event-card:hover .event-glass {
    transform: translateY(0);
    opacity: 1;
  }

  /* shimmer sweep — fires once after glass slides in */
  .glass-shimmer {
    position: absolute;
    top: 0; bottom: 0;
    left: -80%;
    width: 55%;
    background: linear-gradient(
      105deg,
      transparent 0%,
      rgba(255,255,255,0.07) 50%,
      transparent 100%
    );
    transform: skewX(-18deg);
    pointer-events: none;
    opacity: 0;
  }
  .event-card:hover .glass-shimmer {
    animation: glassShimmer 0.65s ease 0.48s forwards;
  }
  @keyframes glassShimmer {
    from { left: -80%; opacity: 1; }
    to   { left: 130%; opacity: 1; }
  }

  /* ── staggered reveal — 2 levels ── */
  .event-cat,
  .event-title,
  .glass-footer {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.32s, transform 0.32s;
  }
  .event-card:hover .event-cat   { opacity: 1; transform: translateY(0); transition-delay: 0.12s; }
  .event-card:hover .event-title { opacity: 1; transform: translateY(0); transition-delay: 0.18s; }
  .event-card:hover .glass-footer { opacity: 1; transform: translateY(0); transition-delay: 0.26s; }

  /* category */
  .event-cat {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ca);
    margin-bottom: 8px;
  }
  .event-cat::before {
    content: '';
    width: 16px; height: 1.5px;
    background: var(--ca);
    border-radius: 2px;
    flex-shrink: 0;
    opacity: 0.8;
  }

  /* title */
  .event-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--ca);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.08;
    margin-bottom: 0;
    text-shadow: 0 1px 10px rgba(0,0,0,0.5);
  }

  /* footer row — meta left, pill right */
  .glass-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 12px;
    padding-top: 11px;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .event-meta {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.4;
    min-width: 0;
  }

  /* CTA pill — right side */
  .event-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: 1px solid color-mix(in srgb, var(--ca) 65%, transparent);
    border-radius: 100px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ca);
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.22s, border-color 0.22s;
  }
  .event-card:hover .event-cta:hover {
    background: color-mix(in srgb, var(--ca) 18%, transparent);
    border-color: var(--ca);
  }

  /* ── featured card ── */
  .event-card.featured { grid-column: span 2; }
  .event-card.featured .event-img { aspect-ratio: 21/9; }
  .event-card.featured .event-glass { padding: 24px 28px 26px; }
  .event-card.featured .event-title { font-size: 1.8rem; }

  @media (max-width: 900px) {
    .events-grid { grid-template-columns: 1fr; }
    .event-card.featured { grid-column: span 1; }
    .event-card.featured .event-img { aspect-ratio: 16/9; }
  }
</style>
