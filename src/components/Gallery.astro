---
import { programs } from '../data/programs';

const cards = programs.map((p, i) => ({
  ...p,
  href: `/programs/${p.slug}`,
  featured: i === 0,
  cardStyle: `--ca:${p.brand?.primaryOnDark ?? '#28B870'};`,
}));
---
<section id="gallery">
  <div class="reveal">
    <div class="section-label">Programs & Gallery</div>
    <h2 class="section-title">Moments That<br /><span>Define</span> Us</h2>
  </div>

  <div class="events-grid">
    {cards.map((p) => (
      <a href={p.href} class:list={["event-card", "reveal", p.featured && "featured"]} style={p.cardStyle}>

        <div class="event-img">
          <img src={p.heroImage} alt={p.title} />
        </div>

        {/* always-visible resting label — fades out on hover */}
        <div class="event-rest">
          <span class="rest-cat">{p.category}</span>
          <h3 class="rest-title">{p.title}</h3>
        </div>

        {/* hover reveal — full-card center stage */}
        <div class="event-reveal">
          <span class="reveal-cat">{p.category}</span>
          <div class="reveal-line"></div>
          <h3 class="reveal-title">{p.title}</h3>
          <p class="reveal-meta">{p.cardMeta}</p>
          <span class="reveal-cta">
            View Program
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </span>
        </div>

      </a>
    ))}
  </div>
</section>

<style>
  #gallery {
    padding: 120px 8% 100px;
    background: var(--color-cream);
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 50px;
  }

  /* ── card ── */
  .event-card {
    display: block;
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    text-decoration: none;
    background: #111;
    border: 1.5px solid rgba(255,255,255,0.06);
    transition:
      transform    0.45s cubic-bezier(0.25,0.46,0.45,0.94),
      box-shadow   0.45s,
      border-color 0.45s;
  }
  .event-card:hover {
    transform: translateY(-8px) scale(1.012);
    border-color: color-mix(in srgb, var(--ca) 50%, transparent);
    box-shadow: 0 32px 64px rgba(0,0,0,0.24);
  }

  /* ── photo — blurs on hover ── */
  .event-img { width: 100%; aspect-ratio: 16/9; overflow: hidden; }
  .event-img img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition:
      filter    0.55s cubic-bezier(0.25,0.46,0.45,0.94),
      transform 0.55s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  /* scale(1.1) hides the blurry pixel fringe at the crop edge */
  .event-card:hover .event-img img {
    filter: blur(7px) brightness(0.68);
    transform: scale(1.1);
  }

  /* ── resting label — bottom scrim + minimal text ── */
  .event-rest {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 72px 22px 20px;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.3) 55%, transparent 100%);
    pointer-events: none;
    transition: opacity 0.38s ease;
  }
  .event-card:hover .event-rest { opacity: 0; }

  .rest-cat {
    display: block;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ca);
    margin-bottom: 4px;
    opacity: 0.9;
  }
  .rest-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.15rem;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.08;
    margin: 0;
    text-shadow: 0 1px 6px rgba(0,0,0,0.5);
  }

  /* ── hover reveal — center stage, no background ── */
  .event-reveal {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 28px 24px;
    pointer-events: none;           /* only the card link needs pointer events */
  }
  .event-card:hover .event-reveal { pointer-events: auto; }

  /* category — slides down from above */
  .reveal-cat {
    display: block;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ca);
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.32s ease, transform 0.32s ease;
  }
  .event-card:hover .reveal-cat {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.05s;
  }

  /* accent line — draws left to right */
  .reveal-line {
    width: 48px;
    height: 2px;
    background: var(--ca);
    border-radius: 2px;
    margin: 10px auto;
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.25,0.46,0.45,0.94), opacity 0.2s;
  }
  .event-card:hover .reveal-line {
    transform: scaleX(1);
    opacity: 1;
    transition-delay: 0.12s;
  }

  /* title — the main pop: scales in */
  .reveal-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    color: var(--ca);                       /* brand accent — each card its own color */
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.06;
    margin: 0;
    text-shadow:
      0 2px 20px rgba(0,0,0,0.6),
      0 0  40px color-mix(in srgb, var(--ca) 30%, transparent);
    opacity: 0;
    transform: scale(0.88);
    transition: opacity 0.38s ease, transform 0.38s cubic-bezier(0.34,1.56,0.64,1);
  }
  .event-card:hover .reveal-title {
    opacity: 1;
    transform: scale(1);
    transition-delay: 0.18s;
  }

  /* meta — slides up from below */
  .reveal-meta {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.72);
    margin-top: 10px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .event-card:hover .reveal-meta {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.26s;
  }

  /* CTA pill — last to appear */
  .reveal-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    padding: 8px 20px;
    border: 1.5px solid rgba(255,255,255,0.5);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(255,255,255,0.1);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease, background 0.2s;
  }
  .event-card:hover .reveal-cta {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.34s;
  }
  /* secondary hover on the pill itself */
  .event-reveal:hover .reveal-cta {
    background: rgba(255,255,255,0.2);
    border-color: #fff;
  }

  /* ── featured card ── */
  .event-card.featured { grid-column: span 2; }
  .event-card.featured .event-img { aspect-ratio: 21/9; }
  .event-card.featured .rest-title { font-size: 1.5rem; }
  .event-card.featured .reveal-title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  }
  .event-card.featured .reveal-line { width: 64px; }

  /* ── mobile / touch: always show hover content ── */
  @media (hover: none) {
    .event-rest { display: none; }
    .event-reveal { pointer-events: auto; }
    .reveal-cat,
    .reveal-line,
    .reveal-title,
    .reveal-meta,
    .reveal-cta {
      opacity: 1;
      transform: none !important;
    }
    /* keep a scrim so text stays legible on touch */
    .event-reveal::before {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.55);
      z-index: -1;
    }
  }

  @media (max-width: 900px) {
    .events-grid { grid-template-columns: 1fr; }
    .event-card.featured { grid-column: span 1; }
    .event-card.featured .event-img { aspect-ratio: 16/9; }
  }
</style>
